PORT=5000
MONGO_URI=mongodb://localhost:27017/krishimitra
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
NODE_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional weather alert delivery via Twilio.
# Use an E.164 phone number for SMS_FROM (for example, +1...).
# WhatsApp sender must be enabled on your Twilio account (for example, whatsapp:+14155238886).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
